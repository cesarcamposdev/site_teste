# Copie para .env e ajuste. NUNCA versione o .env.
HOST=127.0.0.1
PORT=3000

# Segredo ("pepper") usado junto com o Argon2id. Mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Se trocar depois, as senhas já cadastradas deixam de funcionar.
PEPPER=

# Cookies Secure funcionam em http://localhost no Chrome/Edge/Firefox.
# No Safari, use false (apenas para teste local).
COOKIE_SECURE=true
ALLOW_REGISTRATION=true

# Contas-isca (honeytokens): qualquer tentativa de login nelas dispara o alerta.
HONEY_USERS=admin,root,administrator

# Alerta visual/sonoro (arquivos dentro de public/assets/)
JUMPSCARE_ENABLED=true
JUMPSCARE_IMAGE=jumpscare.jpg
JUMPSCARE_AUDIO=som_jumpscare_max_volume.mp3

# Detecção / bloqueio
BRUTE_ALERT_AFTER=5
LOCK_AFTER=3
